.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# ============================================
# Python
# ============================================

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# ============================================
# Django
# ============================================

# Local SQLite database
db.sqlite3
db.sqlite3-journal

# User-uploaded/generated media
media/

# Collected static files
staticfiles/

# Django/Python logs
*.log

# ============================================
# Environment / Secrets
# ============================================

.env
.env.*
!.env.example

# ============================================
# Testing / Coverage
# ============================================

.pytest_cache/
.coverage
.coverage.*
htmlcov/

